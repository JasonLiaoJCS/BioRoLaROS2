 from .plans import LEGS, describe, motion_pwm_cap
 
 POSITIONS = ('左前', '左中', '左後', '右前', '右中', '右後')
+
+
+def settings_summary(site, plan):
+    """Display native effective values; standard presets never gate operation."""
+    if not site or not site.get('parameters'):
+        return ''
+    nodes = site['parameters']
+    lines = [f'現場設定版本：{site.get("revision", "未知")}（依目前設定執行，調參不需符合固定預設）']
+    for name, key in (('Calibration', 'rinbo_cali'), ('Standing', 'rinbo_standing'),
+                      ('Manual', 'rinbo_manual'), ('Tripod', 'rinbo_tripod_rslip')):
+        params = nodes.get(key)
+        if params is None and key == 'rinbo_manual':
+            params = nodes.get('rinbo_standing')
+        if not params:
+            continue
+        values = []
+        for label, field in (('KP', 'kp'), ('KD', 'kd'), ('K_FF', 'k_ff'), ('PWM', 'max_pwm')):
+            value = params.get(field)
+            if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value):
+                values.append(f'{label}={value:g}')
+        if values:
+            lines.append(f'{name}：'+ '　'.join(values))
+    cap = motion_pwm_cap(site)
+    lines.append(f'逐腳本次有效 PWM 上限：{min(plan["max_pwm"], cap):g}'
+                 f'（計畫 {plan["max_pwm"]:g}、現場 Manual {cap:g}，取較小值）')
+    return '\n'.join(lines)
 
 
