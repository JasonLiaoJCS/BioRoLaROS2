+    cap = min(plan['max_pwm'], motion_pwm_cap(site))
+    if demand > cap:
+        return (f'出力提示：目前旋轉速度的前饋項約需 {demand:.0f} PWM，已高於有效上限 {cap:g}。'
+                '可選 13 調整出力或選 2 降低速度；此估算不含位置修正與實際負載。')
+    return ''
 
 
