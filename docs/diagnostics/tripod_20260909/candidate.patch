+    void record_trace(bool fault) {
+        if (!trace_ready_) {
+            if (fault) std::fprintf(stderr, "TRIPOD_FAULT_FRAME unavailable: no calculated motion sample\n");
+            return;
+        }
+        const double now_s = trace_debug_.header.stamp.sec + trace_debug_.header.stamp.nanosec*1e-9;
+        if (fault) {
+            for (const auto& entry : trace_history_)
+                std::fprintf(stderr, "TRIPOD_PREFAULT %s\n", entry.c_str());
+            const auto entry = format_trace();
+            std::fprintf(stderr, "TRIPOD_FAULT_FRAME reason=%s observation_s=%.9f %s\n",
+                safety_stop_reason_.c_str(), this->now().seconds(), entry.c_str());
+            std::fflush(stderr);
+        } else if (last_trace_sample_s_ < 0 || now_s-last_trace_sample_s_ >= .02) {
+            const auto entry = format_trace();
+            trace_history_.push_back(entry);
+            while (trace_history_.size() > 100) trace_history_.pop_front();
+            last_trace_sample_s_ = now_s;
+            if (last_trace_log_s_ < 0 || now_s-last_trace_log_s_ >= .1) {
+                RCLCPP_INFO(get_logger(), "TRIPOD_TRACE %s", entry.c_str());
+                last_trace_log_s_ = now_s;
+            }
+        }
+    }
