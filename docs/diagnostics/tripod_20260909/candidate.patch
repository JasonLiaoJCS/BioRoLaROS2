+    // Advisory only: these feedforward gains have not been identified as a
+    // hardware model. Show clipping/slew conflicts without adding an interlock
+    // or changing the operator's gains, PWM limits, duration or ratios.
+    void report_reference_budget() {
+        double peak_pwm = 0, peak_slew = 0;
+        auto sample = [&](auto velocity, double duration) {
+            constexpr int samples = 20000;
+            double previous = effort_.feedforward(velocity(0));
+            for (int k = 0; k <= samples; ++k) {
+                const double ff = effort_.feedforward(velocity(duration*k/samples));
+                peak_pwm = std::max(peak_pwm, std::fabs(ff));
+                if (k) peak_slew = std::max(peak_slew,
+                    std::fabs(ff-previous)*samples/duration);
+                previous = ff;
+            }
+        };
+        sample([&](double t) {
+            return rinbo_fsm::tripod::startup(t, startup_duration_, 0,
+                theta_home_*rad_to_counts_).velocity;
+        }, startup_duration_);
+        const double saved_ratio = current_ratio_;
+        current_ratio_ = target_ratio_; // fastest configured phase rate
+        sample([&](double t) {
+            double p, v;
+            compute_group_reference(t_center_ + t/current_ratio_, p, v);
+            return v*rad_to_counts_;
+        }, (period_ + period_/4)*current_ratio_);
+        current_ratio_ = saved_ratio;
+        reference_peak_pwm_ = peak_pwm;
+        reference_peak_slew_ = peak_slew;
+        if (!std::isfinite(peak_pwm) || !std::isfinite(peak_slew) ||
+            peak_pwm >= max_pwm_ || peak_slew >= safety_.pwm_slew_rate_per_sec) {
+            std::ostringstream reason;
+            reason << "TRIPOD_REFERENCE_WARNING nominal_feedforward_peak=" << peak_pwm
+                   << " pwm_limit=" << max_pwm_ << " nominal_feedforward_slew=" << peak_slew
+                   << " slew_limit=" << safety_.pwm_slew_rate_per_sec
+                   << "; nominal effort will clip/lag; review a slower trajectory (advisory only)";
+            RCLCPP_WARN(get_logger(), "%s", reason.str().c_str());
+        }
+        RCLCPP_INFO(get_logger(),
+            "TRIPOD_REFERENCE_BUDGET startup=%.3fs ratios=%.3f->%.3f ff_peak=%.3f/%.3f ff_slew=%.3f/%.3f (model only)",
+            startup_duration_, start_ratio_, target_ratio_, peak_pwm, max_pwm_,
+            peak_slew, safety_.pwm_slew_rate_per_sec);
+    }
