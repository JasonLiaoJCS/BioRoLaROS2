+            node->fail_closed(std::string("unhandled controller error: ") + error.what());
+            throw;
+        }
+        const bool failed = node->failed();
+        rclcpp::shutdown();
+        return failed ? 2 : 0;
+    } catch (const std::exception& error) {
+        std::cerr << "[FATAL] Tripod: " << error.what() << std::endl;
+        if (rclcpp::ok()) rclcpp::shutdown();
+        return 1;
+    }
