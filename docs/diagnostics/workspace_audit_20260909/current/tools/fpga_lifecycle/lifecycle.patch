+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_EN2,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_EN3,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_EN4,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_EN5,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_EN6};
+    const uint32_t r_iv_[] = {
+        NiFpga_FPGA_POWER_RS485_v2_ControlU16_input_voltage,
+        NiFpga_FPGA_POWER_RS485_v2_ControlU16_input_voltage2,
+        NiFpga_FPGA_POWER_RS485_v2_ControlU16_input_voltage3,
+        NiFpga_FPGA_POWER_RS485_v2_ControlU16_input_voltage4,
+        NiFpga_FPGA_POWER_RS485_v2_ControlU16_input_voltage5,
+        NiFpga_FPGA_POWER_RS485_v2_ControlU16_input_voltage6};
+    const uint32_t r_state_[] = {
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_state,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_state2,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_state3,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_state4,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_state5,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_state6};
+    for (int i = 0; i < 6; ++i) {
+        NiFpga_MergeStatus(&off_status, NiFpga_WriteBool(session_, r_en_[i], NiFpga_False));
+        NiFpga_MergeStatus(&off_status, NiFpga_WriteU16(session_, r_iv_[i], 0));
+        NiFpga_MergeStatus(&off_status, NiFpga_WriteBool(session_, r_state_[i], NiFpga_False));
+    }
+    const uint32_t power[] = {
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_Power,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_Signal,
+        NiFpga_FPGA_POWER_RS485_v2_ControlBool_Digital};
+    for (uint32_t reg : power)
+        NiFpga_MergeStatus(&off_status, NiFpga_WriteBool(session_, reg, NiFpga_False));
+    for (int i = 0; i < 6; ++i) {
+        NiFpga_Bool enabled = NiFpga_True, state = NiFpga_True;
+        uint16_t pwm = 65535;
+        NiFpga_MergeStatus(&off_status, NiFpga_ReadBool(session_, r_en_[i], &enabled));
+        NiFpga_MergeStatus(&off_status, NiFpga_ReadU16(session_, r_iv_[i], &pwm));
+        NiFpga_MergeStatus(&off_status, NiFpga_ReadBool(session_, r_state_[i], &state));
