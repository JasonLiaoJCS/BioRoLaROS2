+bool FpgaHandler::safe_shutdown()
+{
+    if (shutdown_attempted_) return shutdown_ok_;
+    shutdown_attempted_ = true;
+    lifecycle::event("shutdown_begin commands_inhibited");
+    if (!session_open_) {
+        lifecycle::event("shutdown_FAILED no_session PowerUnknown");
+        return false;
+    }
