+        NiFpga_MergeStatus(&off_status, NiFpga_ReadBool(session_, reg, &value));
+        matched = matched && !value;
+    }
+    shutdown_ok_ = NiFpga_IsNotError(off_status) && matched;
+    NiFpga_MergeStatus(&status_, off_status);
+    lifecycle::event(shutdown_ok_
+        ? "shutdown_controls_verified physical_power_unverified"
+        : "shutdown_FAILED PowerUnknown");
+    return shutdown_ok_;
+}
