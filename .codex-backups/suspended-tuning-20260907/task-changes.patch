+TEST_F(RinboPowerGuardTest, RunningOutputToleratesTransientButPersistentCurrentStillTrips) {
+    rclcpp::NodeOptions options;
+    options.parameter_overrides({rclcpp::Parameter("safety.current_trip_samples", 3)});
